# Copy this file to sdkconfig.secrets and fill in your own passwords.
# sdkconfig.secrets is not in git (.gitignore). The build reads it after sdkconfig.defaults
# (see CMakeLists.txt). Like sdkconfig.defaults, it only applies when no sdkconfig exists:
# delete sdkconfig after editing.

# Mode A: the existing Wi-Fi network's password (8-63 characters, empty for an open network)
CONFIG_BRIDGE_STA_PASSWORD="your-wifi-password"

# Mode A: the setup access point (8-63 characters)
CONFIG_BRIDGE_SETUP_AP_PASSWORD="your-setup-password"

# Mode 0: the bridge's own access point (8-63 characters)
CONFIG_EXAMPLE_WIFI_PASSWORD="your-ap-password"
